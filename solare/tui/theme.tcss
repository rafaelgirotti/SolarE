/* Retro monochrome-phosphor terminal theme - see docs/ARCHITECTURE.md. Dense text, strong panel
   framing, green/amber palette, no shader/glow effects. */

Screen {
    background: #000000;
    color: #33cc33;
}

#job_panel {
    border: heavy #33cc33;
    border-title-color: #55ff55;
    border-title-style: bold;
    color: #33cc33;
    height: auto;
    padding: 0 1;
}

#chunks_bar {
    height: 1;
    width: 50%;
    margin-top: 0;
}

#hw_panel {
    border: heavy #ffb000;
    border-title-color: #ffb000;
    border-title-style: bold;
    color: #ffb000;
    height: auto;
    padding: 0 1;
    margin-top: 1;
}

#solar_panel {
    border: heavy #33cc33;
    border-title-color: #55ff55;
    border-title-style: bold;
    color: #33cc33;
    height: auto;
    padding: 0 1;
    margin-top: 1;
}

#log_panel {
    border: heavy #33cc33;
    border-title-color: #55ff55;
    border-title-style: bold;
    background: #000000;
    color: #33cc33;
    margin-top: 1;
    padding: 0 1;
    height: 1fr;
}

#controls {
    height: 3;
    align: center middle;
    background: #000000;
}

#controls Button {
    /* Deliberately no background/border/color override here - variant="success" (applied
    dynamically in _update_controls()) already gives these the real embossed/3D Textual button
    look (lighter top bevel edge, darker bottom edge, solid green fill) for whichever one is the
    current primary action; every other button falls back to Textual's own default (default)
    variant, the same muted black/gray look as the confirm dialog's No. Disabled state falls
    back to Textual's own default (dimmed text opacity, same bevel), which already reads fine. */
    margin: 0 1;
    min-width: 10;
}

#controls Button:focus {
    /* Same real bug as the confirm dialog's Yes button (see theme.tcss's ConfirmScreen section):
    Textual's default Button:focus applies bold+reverse text-style, which swaps fg/bg and reads
    as a stray dark band through the button - confirmed live here too (these buttons never had
    a :focus override before, so clicking one and giving it focus would have shown the same
    glitch). Neutralized the same way: keep bold, drop reverse. */
    text-style: bold;
}

Footer {
    background: #000000;
    color: #4a5a4a;
}

Footer > .footer-key {
    background: #000000;
    color: #55ff55;
}

Footer > .footer-description {
    background: #000000;
    color: #4a5a4a;
}

ConfigPickerScreen {
    align: center middle;
}

#picker_dialog {
    width: 80%;
    height: 80%;
    border: heavy #55ff55;
    background: #000000;
    padding: 1 2;
}

#picker_title {
    color: #55ff55;
    text-style: bold;
    height: 1;
}

#picker_tree {
    background: #000000;
    color: #33cc33;
}

ConfirmScreen {
    align: center middle;
}

#confirm_dialog {
    width: 60;
    height: auto;
    border: heavy #55ff55;
    background: #000000;
    padding: 1 2;
}

#confirm_message {
    width: 100%;
    color: #55ff55;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

#confirm_buttons {
    width: 100%;
    height: 3;
    align: center middle;
}

#confirm_buttons Button {
    margin: 0 1;
    min-width: 12;
}

#confirm_buttons Button:focus {
    /* This is the one real bug in an otherwise-liked look: Textual's built-in Button:focus style
    applies text-style: bold reverse (swaps fg/bg) on top of whatever variant coloring is already
    there - on the "success" variant that reads as a stray dark band cutting through the green
    button. Neutralizing just the reverse keeps the variant's own background/border/bevel exactly
    as Textual renders it, which is the actual look wanted here. */
    text-style: bold;
}
