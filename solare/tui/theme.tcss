/* Retro monochrome-phosphor terminal theme - see docs/ARCHITECTURE.md. Dense text, strong panel
   framing, green/amber palette, no shader/glow effects. */

Screen {
    background: #000000;
    color: #33cc33;
}

#job_panel {
    border: heavy #33cc33;
    border-title-color: #55ff55;
    border-title-style: bold;
    color: #33cc33;
    height: auto;
    padding: 0 1;
}

#batch_line {
    height: 1;
    width: 100%;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#chunks_bar {
    height: 1;
    width: 50%;
    margin-top: 0;
}

#hw_panel {
    border: heavy #ffb000;
    border-title-color: #ffb000;
    border-title-style: bold;
    color: #ffb000;
    height: auto;
    padding: 0 1;
    margin-top: 0;
}

#solar_panel {
    border: heavy #33cc33;
    border-title-color: #55ff55;
    border-title-style: bold;
    color: #33cc33;
    height: auto;
    padding: 0 1;
    margin-top: 0;
}

#log_panel {
    border: heavy #33cc33;
    border-title-color: #55ff55;
    border-title-style: bold;
    background: #000000;
    color: #33cc33;
    margin-top: 0;
    padding: 0 1;
    height: 1fr;
    scrollbar-size-vertical: 1;
    /* ScrollView's own default is overflow-x: auto, which is what lets a horizontal scrollbar
    appear at all - explicit width on every write() (see app.py._render_log_panel) already keeps
    lines within the visible area, but RichLog's own "widest line ever written" tracker only ever
    grows and never resets, so any transient over-measurement (a real terminal resize during a
    long-running session, in particular) leaves it stuck permanently. Since wrap=True means we
    never actually need horizontal scrolling - every line is meant to fit by wrapping, not by
    scrolling to see the rest - hidden here is a correct policy, not a workaround for one specific
    cause. */
    overflow-x: hidden;
    /* Textual's own defaults are bright magenta-on-gray - clashes hard against this theme's
    dim monochrome green/black, which is most of why the scrollbars read as "too big": a
    same-thickness bar in a jarring, unrelated color draws far more attention than one that
    blends into the panel it's attached to. */
    scrollbar-color: #33cc33;
    scrollbar-color-hover: #55ff55;
    scrollbar-color-active: #55ff55;
    scrollbar-background: #000000;
    scrollbar-background-hover: #001a00;
    scrollbar-background-active: #001a00;
}

Footer {
    background: #000000;
    color: #4a5a4a;
}

Footer > .footer-key {
    background: #000000;
    color: #55ff55;
}

Footer > .footer-description {
    background: #000000;
    color: #4a5a4a;
}

ConfigPickerScreen {
    align: center middle;
}

#picker_dialog {
    width: 80%;
    height: 80%;
    border: heavy #55ff55;
    background: #000000;
    padding: 1 2;
}

#picker_title {
    color: #55ff55;
    text-style: bold;
    height: 1;
}

#picker_tree {
    background: #000000;
    color: #33cc33;
}

ConfirmScreen {
    align: center middle;
}

#confirm_dialog {
    width: 60;
    height: auto;
    border: heavy #55ff55;
    background: #000000;
    padding: 1 2;
}

#confirm_message {
    width: 100%;
    color: #55ff55;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

#confirm_buttons {
    width: 100%;
    height: 3;
    align: center middle;
}

#confirm_buttons Button {
    margin: 0 1;
    min-width: 12;
}

#confirm_buttons Button:focus {
    /* This is the one real bug in an otherwise-liked look: Textual's built-in Button:focus style
    applies text-style: bold reverse (swaps fg/bg) on top of whatever variant coloring is already
    there - on the "success" variant that reads as a stray dark band cutting through the green
    button. Neutralizing just the reverse keeps the variant's own background/border/bevel exactly
    as Textual renders it, which is the actual look wanted here. */
    text-style: bold;
}
