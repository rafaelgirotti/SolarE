/* Retro monochrome-phosphor terminal theme - see docs/ARCHITECTURE.md. Dense text, strong panel
   framing, green/amber palette, no shader/glow effects. */

Screen {
    background: #000000;
    color: #33cc33;
}

#job_panel {
    border: heavy #33cc33;
    border-title-color: #55ff55;
    border-title-style: bold;
    color: #33cc33;
    height: auto;
    padding: 0 1;
}

#chunks_bar {
    height: 1;
    width: 50%;
    margin-top: 0;
}

#hw_panel {
    border: heavy #ffb000;
    border-title-color: #ffb000;
    border-title-style: bold;
    color: #ffb000;
    height: auto;
    padding: 0 1;
    margin-top: 1;
}

#solar_panel {
    border: heavy #33cc33;
    border-title-color: #55ff55;
    border-title-style: bold;
    color: #33cc33;
    height: auto;
    padding: 0 1;
    margin-top: 1;
}

#log_panel {
    border: heavy #33cc33;
    border-title-color: #55ff55;
    border-title-style: bold;
    background: #000000;
    color: #33cc33;
    margin-top: 1;
    padding: 0 1;
    height: 1fr;
}

#controls {
    height: 3;
    align: center middle;
    background: #000000;
}

#controls Button {
    margin: 0 1;
    min-width: 18;
    background: #000000;
    color: #33cc33;
    border: heavy #33cc33;
}

#controls Button:hover {
    background: #1a3a1a;
}

#controls Button:disabled {
    color: #4a5a4a;
    border: heavy #4a5a4a;
}

Footer {
    background: #000000;
    color: #4a5a4a;
}

Footer > .footer-key {
    background: #000000;
    color: #55ff55;
}

Footer > .footer-description {
    background: #000000;
    color: #4a5a4a;
}

ConfigPickerScreen {
    align: center middle;
}

#picker_dialog {
    width: 80%;
    height: 80%;
    border: heavy #55ff55;
    background: #000000;
    padding: 1 2;
}

#picker_title {
    color: #55ff55;
    text-style: bold;
    height: 1;
}

#picker_tree {
    background: #000000;
    color: #33cc33;
}

ConfirmScreen {
    align: center middle;
}

#confirm_dialog {
    width: 60;
    height: auto;
    border: heavy #55ff55;
    background: #000000;
    padding: 1 2;
}

#confirm_message {
    width: 100%;
    color: #55ff55;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

#confirm_buttons {
    width: 100%;
    height: 3;
    align: center middle;
}

#confirm_buttons Button {
    margin: 0 1;
    min-width: 12;
    background: #000000;
    color: #33cc33;
    border: heavy #33cc33;
}

#confirm_buttons Button:hover {
    background: #1a3a1a;
}

#confirm_buttons Button:focus {
    /* Textual's own default Button:focus style applies a bold+reverse text-style (swaps fg/bg),
    which turned this into a solid green block with black text - confirmed live, jarring against
    every other flat black-background button in the app. Same subtle highlight as :hover instead,
    no reverse. */
    text-style: bold;
    background: #1a3a1a;
    background-tint: transparent;
}

#confirm_buttons #confirm_yes {
    color: #55ff55;
    border: heavy #55ff55;
}
