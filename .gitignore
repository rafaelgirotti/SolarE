# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
.python-version

# Secrets - never commit (Growatt API login)
credentials.json
.env

# Last-started-job tracking (solare/tui/last_job.py) - a real, personal config file path.
state.json

# Per-title recipe configs - only the example template is ever committed.
# Real configs carry the user's actual source/output file paths.
config/*.json
!config/config.example.json

# Per-title investigation history - genuinely useful locally (full context, file paths,
# source-release specifics for encoding decisions), but never meant to be public even after
# this project itself goes public. Ignored wholesale, not just individual files, so a new file
# dropped in here can never accidentally end up staged.
history/

# Local encoder tool binaries (av1an's dependencies: ffmpeg, x265, SVT-AV1, MKVToolNix,
# VapourSynth, dovi_tool) - never committed. Large, platform-specific, and often GPL-licensed;
# redistributing them through this repo isn't appropriate. See README's Requirements section for
# where to get each one - point PATH at your own install, or drop them in tools/ (this folder) and
# solare picks them up automatically.
tools/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
